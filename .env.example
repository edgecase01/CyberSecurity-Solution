# =============================================================================
# AI Cybersecurity Platform — Environment Variables (copy to .env)
# =============================================================================
# cp .env.example .env
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=cybersec
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=cybersec
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Async SQLAlchemy / service connection string (api-gateway and microservices)
# Update user, password, host, and db to match POSTGRES_* above.
DATABASE_URL=postgresql+asyncpg://cybersec:change_me_postgres_password@postgres:5432/cybersec

# -----------------------------------------------------------------------------
# Redis (caching + Celery broker)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# -----------------------------------------------------------------------------
# RabbitMQ (async messaging between services)
# -----------------------------------------------------------------------------
RABBITMQ_USER=cybersec
RABBITMQ_PASSWORD=change_me_rabbitmq_password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/

RABBITMQ_URL=amqp://cybersec:change_me_rabbitmq_password@rabbitmq:5672/

# Management UI (local dev): http://localhost:15672
RABBITMQ_MANAGEMENT_PORT=15672

# -----------------------------------------------------------------------------
# Auth / security (used in later steps)
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change_me_jwt_secret_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# -----------------------------------------------------------------------------
# Gmail API (notification-service)
# https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Google OAuth2 (backend /auth/login → /auth/callback)
# Add this exact redirect URI in Google Cloud Console → Credentials → OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# VirusTotal (threat-intel-service / scan-service)
# https://www.virustotal.com/gui/my-apikey
# -----------------------------------------------------------------------------
VIRUSTOTAL_API_KEY=

# -----------------------------------------------------------------------------
# OpenAI (ml-inference placeholders / enrichment)
# https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# CORS (web app + extension — adjust for local dev)
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,chrome-extension://

# -----------------------------------------------------------------------------
# Website scan (backend)
# -----------------------------------------------------------------------------
SCAN_CACHE_TTL_SECONDS=86400
SCAN_REQUEST_TIMEOUT_SECONDS=15.0
